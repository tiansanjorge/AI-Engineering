OPENAI_API_KEY=your-key-here
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
# Debe coincidir con la region de tu proyecto en Langfuse Cloud:
#   UE: https://cloud.langfuse.com   |   EE.UU.: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
# Opcionales (defaults entre parentesis)
VISION_MODEL=gpt-4o
AGENT_MODEL=gpt-4o
# Entorno con el que se etiquetan las trazas en Langfuse (opcional; por defecto 'default')
# LANGFUSE_TRACING_ENVIRONMENT=development
